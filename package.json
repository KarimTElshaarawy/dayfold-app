{
  "name": "dayfold-app",
  "version": "1.0.0",
  "description": "Dayfold for iPhone and Android: a fully on-device study planner built with Capacitor.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
